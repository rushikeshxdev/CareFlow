# ==========================================
# CareFlow System Environment Configuration
# ==========================================

# Environment Mode (development | production | test)
NODE_ENV=development
PORT=3001

# Core Backend (NestJS) Settings
BACKEND_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://careflow_user:careflow_password@localhost:5432/careflow_db?schema=public

# Redis Configuration (Queue & State Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Queue Reliability Configuration (BullMQ)
QUEUE_MAX_ATTEMPTS=3
QUEUE_BACKOFF_DELAY_MS=2000

# Authentication & Security
JWT_SECRET=super_secret_jwt_access_token_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# FastAPI AI Service Configuration
AI_SERVICE_URL=http://localhost:8000
AI_PROVIDER=mock # Options: mock | gemini (Note: AI_API_KEY required when AI_PROVIDER=gemini)
AI_API_KEY=your_gemini_api_key_placeholder

# Frontend Configuration (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000
