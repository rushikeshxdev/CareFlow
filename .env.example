# ==========================================
# CareFlow System Environment Configuration
# ==========================================

# Environment Mode
NODE_ENV=development
PORT=3001

# Core Backend (NestJS) Settings
BACKEND_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://careflow_user:careflow_password@localhost:5432/careflow_db?schema=public

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=7d

# FastAPI AI Service Configuration
AI_SERVICE_URL=http://localhost:8000
AI_PROVIDER=mock # Options: mock | gemini
AI_API_KEY=your_gemini_api_key_here

# Frontend Configuration (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000
