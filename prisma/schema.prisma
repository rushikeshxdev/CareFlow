// CareFlow Database Schema
// PostgreSQL with Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PATIENT
  PROVIDER
  ADMIN
}

enum ProviderType {
  DOCTOR
  HOSPITAL
  DIAGNOSTIC_CENTER
  HOME_CARE
}

enum ServiceType {
  CONSULTATION
  DIAGNOSTIC
  HOME_NURSING
  PHYSIOTHERAPY
  HEALTH_CHECKUP
  SECOND_OPINION
}

enum SlotStatus {
  AVAILABLE
  HELD
  BOOKED
  BLOCKED
}

enum AppointmentStatus {
  HELD
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum AppointmentType {
  IN_PERSON
  VIDEO_CONSULT
  HOME_VISIT
}

enum CareJourneyStatus {
  ACTIVE
  COMPLETED
  PAUSED
}

enum CareEventType {
  CONSULTATION
  DIAGNOSTIC_TEST
  PRESCRIPTION
  FOLLOW_UP
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  role         UserRole      @default(PATIENT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  patient       Patient?
  provider      Provider?
  conversations AIConversation[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Patient {
  id                 String   @id @default(uuid())
  userId             String   @unique
  dateOfBirth        DateTime?
  gender             String?
  allergies          String?
  existingConditions String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  careJourneys CareJourney[]

  @@map("patients")
}

model Provider {
  id              String       @id @default(uuid())
  userId          String?      @unique
  name            String
  type            ProviderType @default(DOCTOR)
  bio             String?
  address         String
  city            String
  state           String
  zipCode         String?
  latitude        Float?
  longitude       Float?
  rating          Float        @default(4.5)
  reviewCount     Int          @default(0)
  experienceYears Int          @default(5)
  consultationFee Float        @default(50.0)
  profileImage    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user              User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  specialties       ProviderSpecialty[]
  services          ProviderService[]
  availabilitySlots AvailabilitySlot[]
  appointments      Appointment[]

  @@index([city])
  @@index([type])
  @@index([rating])
  @@map("providers")
}

model Specialty {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  createdAt   DateTime @default(now())

  providers ProviderSpecialty[]

  @@map("specialties")
}

model ProviderSpecialty {
  providerId  String
  specialtyId String

  provider  Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  specialty Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([providerId, specialtyId])
  @@map("provider_specialties")
}

model Service {
  id          String      @id @default(uuid())
  name        String      @unique
  slug        String      @unique
  serviceType ServiceType
  description String?
  createdAt   DateTime    @default(now())

  providers ProviderService[]

  @@map("services")
}

model ProviderService {
  id              String @id @default(uuid())
  providerId      String
  serviceId       String
  customPrice     Float
  durationMinutes Int    @default(30)

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([providerId, serviceId])
  @@map("provider_services")
}

model AvailabilitySlot {
  id              String     @id @default(uuid())
  providerId      String
  startTime       DateTime
  endTime         DateTime
  status          SlotStatus @default(AVAILABLE)
  heldByPatientId String?
  heldUntil       DateTime?
  version         Int        @default(1)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  provider    Provider     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  appointment Appointment?

  @@index([providerId, startTime])
  @@index([status])
  @@map("availability_slots")
}

model Appointment {
  id         String            @id @default(uuid())
  patientId  String
  providerId String
  slotId     String            @unique
  serviceId  String
  type       AppointmentType   @default(IN_PERSON)
  status     AppointmentStatus @default(HELD)
  reason     String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  patient  Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider Provider         @relation(fields: [providerId], references: [id], onDelete: Cascade)
  slot     AvailabilitySlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([providerId])
  @@map("appointments")
}

model CareJourney {
  id          String            @id @default(uuid())
  patientId   String
  title       String
  description String?
  status      CareJourneyStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  patient Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  events  CareEvent[]

  @@map("care_journeys")
}

model CareEvent {
  id            String        @id @default(uuid())
  careJourneyId String
  eventType     CareEventType
  title         String
  description   String?
  eventDate     DateTime      @default(now())
  status        String        @default("COMPLETED")
  createdAt     DateTime      @default(now())

  careJourney CareJourney @relation(fields: [careJourneyId], references: [id], onDelete: Cascade)

  @@map("care_events")
}

model AIConversation {
  id        String   @id @default(uuid())
  userId    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@map("ai_conversations")
}

model AIMessage {
  id             String   @id @default(uuid())
  conversationId String
  sender         String // "USER" | "AI"
  content        String
  metadata       Json?
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("ai_messages")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  timestamp DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
